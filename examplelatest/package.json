{
  "name": "tentap-example-latest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android && npm run reverse-android",
    "reverse-android": "adb reverse tcp:3000 tcp:3000",
    "editor:dev": "vite --config ./src/Examples/Advanced/editor-web/vite.config.ts",
    "editor:build": "vite --config ./src/Examples/Advanced/editor-web/vite.config.ts build && npm run editor:post-build",
    "editor:post-build": "node ../scripts/buildEditor.js ./src/Examples/Advanced/editor-web/build/index.html",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "@tiptap/core": "3.19.0",
    "@tiptap/extension-character-count": "3.19.0",
    "@tiptap/extension-document": "3.19.0",
    "@tiptap/extension-paragraph": "3.19.0",
    "@tiptap/extension-text": "3.19.0",
    "@tiptap/extensions": "3.19.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.1.1",
    "@react-native-community/cli-platform-android": "20.1.1",
    "@react-native-community/cli-platform-ios": "20.1.1",
    "@react-native/eslint-config": "0.82.1",
