    "@react-native/typescript-config": "0.82.1",
    "@tiptap/pm": "3.19.0",
    "@tiptap/react": "3.19.0",
    "@types/react": "19.1.1",
    "babel-plugin-inline-import": "3.0.0",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "8.57.1",
    "pod-install": "0.1.39",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=20"
