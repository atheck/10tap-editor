{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build:android": {
			"inputs": [
				"package.json",
				"android",
				"!android/build",
				"src/*.ts",
				"src/*.tsx",
				"examplelatest/package.json",
				"examplelatest/android",
				"!examplelatest/android/.gradle",
				"!examplelatest/android/build",
				"!examplelatest/android/app/build"
			],
			"outputs": []
		},
		"build:ios": {
			"inputs": [
				"package.json",
				"*.podspec",
				"ios",
				"src/*.ts",
				"src/*.tsx",
				"examplelatest/package.json",
				"examplelatest/ios",
				"!examplelatest/ios/build",
				"!examplelatest/ios/Pods"
			],
			"outputs": []
		}
	}
}