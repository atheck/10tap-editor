{
  "name": "tentap-editor-heck",
  "version": "1.1.0-alpha.8",
  "description": "React Native Rich Text Editor",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/src/index.d.ts"
    },
    "./web": {
      "import": "./lib-web/index.mjs",
      "require": "./lib-web/index.umd.cjs",
      "types": "./lib-web/typescript/webEditorUtils/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "lib-web",
    "scripts",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "editor:dev": "vite",
    "editor:build": "vite build && node ./scripts/buildEditor.js ./src/simpleWebEditor/build/index.html",
    "editor:build-web-utils": "rimraf lib-web && vite build --config ./src/webEditorUtils/vite.config.ts && tsc --project ./src/webEditorUtils",
    "examplelatest": "npm -w tentap-example-latest",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build examplelatest/android/build examplelatest/android/app/build examplelatest/ios/build example76/android/build example76/android/app/build example76/ios/build lib",
    "prepack": "bob build",
    "release": "semantic-release",
    "update": "npx -y npm-check-updates -i --install never && npx -y npm-check-updates -i --target minor --install never && npx -y npm-check-updates -i --target patch --install never && npm update --legacy-peer-deps && npm audit signatures"
  },
  "keywords": [
    "rich text",
    "rich text editor",
    "editor",
    "tiptap react-native",
    "prosemirror react-native",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atheck/10tap-editor.git"
  },
  "author": "atheck",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/atheck/10tap-editor/issues"
  },
  "homepage": "https://github.com/atheck/10tap-editor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.0",
    "@babel/runtime": "7.28.6",
    "@commitlint/config-conventional": "20.4.4",
    "@evilmartians/lefthook": "1.13.6",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.72.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-native": "0.70.19",
    "@vitejs/plugin-react": "5.2.0",
    "commitlint": "20.4.4",
    "del-cli": "5.1.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.2",
    "eslint-plugin-ft-flow": "2.0.3",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "30.3.0",
    "pod-install": "0.1.39",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-native": "0.73.11",
    "react-native-builder-bob": "0.20.4",
    "react-native-webview": "13.16.1",
    "rimraf": "5.0.10",
    "semantic-release": "25.0.3",
    "turbo": "1.13.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.0"
  },
  "overrides": {
    "prosemirror-model": "1.25.4",
    "prosemirror-state": "1.4.3",
    "prosemirror-view": "1.41.3",
    "prosemirror-transform": "1.10.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "workspaces": [
    "example76",
    "examplelatest",
    "website"
  ],
  "engines": {
    "node": ">= 22.12.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example76",
      "<rootDir>/examplelatest",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "lib-web/",
    "**/build/",
    "**/android/build/",
    "**/ios/build/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "./node_modules/.bin/tsc"
        }
      ]
    ]
  },
  "dependencies": {
    "@tiptap/core": "3.20.1",
    "@tiptap/extension-blockquote": "3.20.1",
    "@tiptap/extension-bold": "3.20.1",
    "@tiptap/extension-code": "3.20.1",
    "@tiptap/extension-code-block": "3.20.1",
    "@tiptap/extension-color": "3.20.1",
    "@tiptap/extension-document": "3.20.1",
    "@tiptap/extension-hard-break": "3.20.1",
    "@tiptap/extension-heading": "3.20.1",
    "@tiptap/extension-highlight": "3.20.1",
    "@tiptap/extension-horizontal-rule": "3.20.1",
    "@tiptap/extension-image": "3.20.1",
    "@tiptap/extension-italic": "3.20.1",
    "@tiptap/extension-link": "3.20.1",
    "@tiptap/extension-list": "3.20.1",
    "@tiptap/extension-strike": "3.20.1",
    "@tiptap/extension-subscript": "3.20.1",
    "@tiptap/extension-superscript": "3.20.1",
    "@tiptap/extension-table": "3.20.1",
    "@tiptap/extension-table-cell": "3.20.1",
    "@tiptap/extension-table-header": "3.20.1",
    "@tiptap/extension-table-row": "3.20.1",
    "@tiptap/extension-text-align": "3.20.1",
    "@tiptap/extension-text-style": "3.20.1",
    "@tiptap/extension-underline": "3.20.1",
    "@tiptap/extensions": "3.20.1",
    "@tiptap/pm": "3.20.1",
    "@tiptap/react": "3.20.1",
    "@tiptap/starter-kit": "3.20.1",
    "lodash": "4.17.23",
    "react-dom": "19.2.4"
  }
}
