{
  "name": "tentap-editor-heck",
  "version": "1.3.0",
  "description": "React Native Rich Text Editor",
  "author": "atheck",
  "license": "MIT",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "editor:dev": "vite",
    "editor:build": "vite build && node ./scripts/buildEditor.js ./src/simpleWebEditor/build/index.html",
    "editor:build-web-utils": "rimraf lib-web && vite build --config ./src/webEditorUtils/vite.config.ts && tsc --project ./src/webEditorUtils",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write src/ examplelatest/src/",
    "lint": "biome check src/ examplelatest/src/ && eslint src/ examplelatest/src/",
    "clean": "del-cli android/build examplelatest/android/build examplelatest/android/app/build examplelatest/ios/build lib",
    "prepack": "bob build",
    "release": "semantic-release",
    "update": "npx -y npm-check-updates -i --deep --install never && npx -y npm-check-updates -i --deep --target minor --install never && npx -y npm-check-updates -i --deep --target patch --install never && npm update --legacy-peer-deps && npm audit signatures"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atheck/10tap-editor.git"
  },
  "bugs": {
    "url": "https://github.com/atheck/10tap-editor/issues"
  },
  "homepage": "https://github.com/atheck/10tap-editor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "workspaces": [
    "examplelatest"
  ],
  "dependencies": {
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-blockquote": "3.30.2",
    "@tiptap/extension-bold": "3.30.2",
    "@tiptap/extension-code": "3.30.2",
    "@tiptap/extension-code-block": "3.30.2",
    "@tiptap/extension-color": "3.30.2",
    "@tiptap/extension-document": "3.30.2",
    "@tiptap/extension-font-family": "3.30.2",
    "@tiptap/extension-hard-break": "3.30.2",
    "@tiptap/extension-heading": "3.30.2",
    "@tiptap/extension-highlight": "3.30.2",
    "@tiptap/extension-horizontal-rule": "3.30.2",
    "@tiptap/extension-image": "3.30.2",
    "@tiptap/extension-italic": "3.30.2",
    "@tiptap/extension-link": "3.30.2",
    "@tiptap/extension-list": "3.30.2",
    "@tiptap/extension-paragraph": "3.30.2",
    "@tiptap/extension-strike": "3.30.2",
    "@tiptap/extension-subscript": "3.30.2",
    "@tiptap/extension-superscript": "3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/extension-table-cell": "3.30.2",
    "@tiptap/extension-table-header": "3.30.2",
    "@tiptap/extension-table-row": "3.30.2",
    "@tiptap/extension-text": "3.30.2",
    "@tiptap/extension-text-align": "3.30.2",
    "@tiptap/extension-text-style": "3.30.2",
    "@tiptap/extension-underline": "3.30.2",
    "@tiptap/extensions": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/react": "3.30.2",
    "lodash": "4.18.1",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@biomejs/biome": "2.5.10",
    "@commitlint/config-conventional": "21.2.2",
    "@evilmartians/lefthook": "2.1.10",
    "@react-native/babel-preset": "0.84.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/lodash": "4.17.25",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "commitlint": "21.2.2",
    "del-cli": "7.0.0",
    "eslint": "10.9.0",
    "eslint-config-heck": "11.7.0",
    "pod-install": "1.1.0",
    "react": "19.2.8",
    "react-native": "0.84.1",
    "react-native-builder-bob": "0.43.0",
    "react-native-webview": "14.0.1",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*"
  },
  "engines": {
    "node": ">= 24.14.0"
  },
  "keywords": [
    "rich text",
    "rich text editor",
    "editor",
    "tiptap react-native",
    "prosemirror react-native",
    "react-native",
    "ios",
    "android"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/src/index.d.ts"
    },
    "./web": {
      "import": "./lib-web/index.mjs",
      "require": "./lib-web/index.umd.cjs",
      "types": "./lib-web/typescript/webEditorUtils/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "lib-web",
    "scripts",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/.*"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "./node_modules/.bin/tsc"
        }
      ]
    ]
  }
}
